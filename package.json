{
  "name": "yoinks",
  "version": "0.3.1",
  "description": "Paste a link from YouTube, Shorts, Instagram, TikTok or X and get the video as mp4, right in your terminal.",
  "type": "module",
  "bin": {
    "yoinks": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "author": "Pablo Stanley",
  "keywords": [
    "video",
    "downloader",
    "mp4",
    "yt-dlp",
    "youtube",
    "shorts",
    "instagram",
    "tiktok",
    "twitter",
    "x",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ink": "^7.1.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derthert/yoinks.git"
  },
  "homepage": "https://github.com/derthert/yoinks#readme",
  "bugs": {
    "url": "https://github.com/derthert/yoinks/issues"
  }
}
